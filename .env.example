# AWS credentials are NOT set here: EC2 uses its IAM role, a laptop uses `aws configure`.
AWS_REGION=us-east-2
S3_BUCKET=ops-analyst-agent-yourname
GLUE_DATABASE=last_mile

# LLM: bedrock (default) or groq
LLM=bedrock
SQL_MODEL=us.amazon.nova-pro-v1:0
ANALYST_MODEL=us.amazon.nova-2-lite-v1:0
# LLM=groq
# GROQ_API_KEY=your_groq_key
